# Kun plassholdere. Legg aldri ekte nøkler i denne filen eller i frontend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_ANON_KEY=<LEGACY_ANON_KEY_FOR_EDGE_FUNCTION_FALLBACK_ONLY>
SUPABASE_SERVICE_ROLE_KEY=<SETTES_SOM_EDGE_FUNCTION_SECRET>
# Hostede Edge Functions får SUPABASE_PUBLISHABLE_KEYS og SUPABASE_SECRET_KEYS
# som JSON automatisk. Legacy-verdiene over beholdes kun som lokal fallback i
# overgangsperioden og skal ikke deaktiveres før alle funksjoner er verifisert.

VIPPS_ENVIRONMENT=test
VIPPS_PRODUCTION_CONFIRMED=false
VIPPS_API_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=<VIPPS_TEST_CLIENT_ID>
VIPPS_CLIENT_SECRET=<VIPPS_TEST_CLIENT_SECRET>
VIPPS_SUBSCRIPTION_KEY=<VIPPS_TEST_SUBSCRIPTION_KEY>
VIPPS_MSN=<VIPPS_TEST_MERCHANT_SERIAL_NUMBER>
VIPPS_WEBHOOK_SECRET=<HEMMELIGHET_FRA_WEBHOOK_REGISTRERING>

# Stripe Checkout-reserve. Start alltid med testnøkler. Oppgjørskontoen legges
# bare inn hos Stripe og skal aldri skrives i kode eller sendes i chat.
STRIPE_ENVIRONMENT=test
STRIPE_PRODUCTION_CONFIRMED=false
STRIPE_SECRET_KEY=<STRIPE_TEST_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_TEST_WEBHOOK_SECRET>

# Vipps Login kan bruke samme client ID/secret når produktet ligger på samme
# sales unit. Oppgi egne verdier her hvis Login-produktet har egne nøkler.
VIPPS_LOGIN_CLIENT_ID=<VIPPS_LOGIN_CLIENT_ID>
VIPPS_LOGIN_CLIENT_SECRET=<VIPPS_LOGIN_CLIENT_SECRET>
VIPPS_LOGIN_SUBSCRIPTION_KEY=<VIPPS_LOGIN_SUBSCRIPTION_KEY>
VIPPS_LOGIN_MSN=<VIPPS_LOGIN_MERCHANT_SERIAL_NUMBER>
# Sett bare true hvis sales unit har advanced Login og acr_values er aktivert.
VIPPS_LOGIN_FORCE_APP_AUTH=false

# Vipps WEB_REDIRECT krever HTTPS. Bruk deployet testside eller HTTPS-tunnel.
APP_BASE_URL=https://test.eksempel.no
# Bare for lokal testing av Edge Functions fra oppgitte localhost-adresser.
ALLOW_LOCAL_ORIGINS=false
# Testbetaling pa en deployert testside er sperret som standard. Sett bare true
# for en separat staging-side som aldri deles som produksjon.
ALLOW_DEPLOYED_TEST_PAYMENTS=false

# Valgfri AI- og kartkontroll på annonsesiden. Nøklene brukes bare i Supabase
# Edge Functions og
# skal aldri legges i frontend eller git. Google-nøkkelen må avgrenses til
# Places API (New) og Routes API; sett også kostnadsgrenser hos leverandørene.
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_VISION_MODEL=<VISION_MODEL_WITH_STRUCTURED_OUTPUTS>
GOOGLE_MAPS_API_KEY=<SERVER_KEY_RESTRICTED_TO_PLACES_AND_ROUTES_API>

# Automatisk søk etter eksterne boligforslag. Domenene må være kilder
# virksomheten har lov til å søke i og vise lenker/bilder fra. Ikke legg til
# FINN før en skriftlig avtale uttrykkelig dekker denne bruken.
OPENAI_SEARCH_MODEL=<MODEL_WITH_WEB_SEARCH_AND_STRUCTURED_OUTPUTS>
ALLOWED_LISTING_SEARCH_DOMAINS=godkjent-boligkilde.no
# false bruker OpenAIs indekserte/cachede treff. Sett bare true når avtalene med
# samtlige konfigurerte kilder tillater løpende tilgang.
LISTING_SEARCH_LIVE_ACCESS=false
